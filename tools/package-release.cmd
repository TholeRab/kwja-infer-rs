@echo off
:: Package a release build: build -> collect exe + assets -> ../release/<name>
::
:: Why ../release/ and not target/:
::   target/ is cargo's build directory (gitignored). "cargo clean" wipes it,
::   and a failed build can leave it dirty. A release package must not live
::   somewhere that gets deleted.
::
:: Why the directory name carries a date:
::   A bare commit hash does not tell the recipient which package is newer.
::   Date first sorts naturally; hash second traces back to code.
::
:: Usage: tools\package-release.cmd [--skip-build]
::
:: NOTE: deliberately ASCII-only. cmd.exe parses .cmd in the system ANSI
:: codepage (cp936 here); UTF-8 Chinese comments get split into stray commands
:: and the script breaks (observed once, produced garbage).
setlocal EnableDelayedExpansion
cd /d "%~dp0.."
set "ROOT=%CD%"
set "OUTROOT=%ROOT%\..\release"

if /i not "%~1"=="--skip-build" (
    call tools\build-release.cmd -p kwja-infer
    if errorlevel 1 exit /b 1
)

if not exist "%ROOT%\target\release\kwja-infer.exe" (
    echo ERROR: target\release\kwja-infer.exe not found, build first
    exit /b 1
)

for /f %%i in ('git rev-parse --short HEAD') do set "SHA=%%i"
for /f %%i in ('git rev-parse --abbrev-ref HEAD') do set "BRANCH=%%i"
for /f %%i in ('powershell -NoProfile -Command "Get-Date -Format yyyyMMdd"') do set "DATE=%%i"

set "OUT=%OUTROOT%\kwja-infer-%DATE%-%SHA%"

echo branch: %BRANCH%  commit: %SHA%
echo output: %OUT%

if exist "%OUT%" (
    echo ERROR: target directory already exists: %OUT%
    echo        remove it or use a different commit
    exit /b 1
)

if exist "%ROOT%	argetelease\kwja-infer.exe" (
    rem Warn when the exe is older than the newest source file: the package
    rem would then be named after a commit it was not built from.
    for /f %%i in ('powershell -NoProfile -Command "(Get-ChildItem -Recurse 'cli,crates' -Include *.rs,*.toml | Measure-Object -Property LastWriteTime -Maximum).Maximum.ToString('yyyyMMddHHmmss')"') do set "SRCNEW=%%i"
    for /f %%i in ('powershell -NoProfile -Command "(Get-Item '%ROOT%	argetelease\kwja-infer.exe').LastWriteTime.ToString('yyyyMMddHHmmss')"') do set "EXENEW=%%i"
    if "!SRCNEW!" GTR "!EXENEW!" (
        echo ERROR: exe is older than source files, rebuild first:
        echo        toolsuild-release.cmd -p kwja-infer
        echo        exe  %EXENEW%
        echo        src  !SRCNEW!
        exit /b 1
    )
)

mkdir "%OUT%" || exit /b 1
copy /y "%ROOT%\target\release\kwja-infer.exe" "%OUT%\" >nul || exit /b 1

:: assets is about 5 GB; robocopy with /MIR so no stale leftovers
robocopy "%ROOT%\assets" "%OUT%\assets" /MIR /MT:16 /NFL /NDL /NJH /NJS /NP >nul
if errorlevel 8 (
    echo ERROR: assets copy failed, robocopy exit code %errorlevel%
    exit /b 1
)

:: Release notes generated by a Python helper, NOT by PowerShell.
:: PowerShell's Get-Content decodes with the system ANSI codepage (cp936 here)
:: and mangles UTF-8 Chinese (observed once: whole file turned to garbage).
python "%ROOT%\tools\write-release-notes.py" "%ROOT%\tools\release-notes-template.txt" "%OUT%\README.txt" "%SHA%" "%BRANCH%" "%DATE%"
if errorlevel 1 exit /b 1

echo.
echo contents:
dir /b "%OUT%"
echo.
echo done: %OUT%
