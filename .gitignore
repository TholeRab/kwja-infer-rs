# Rust 构建产物
/target

# 素材（约 5.2 GB，不进 git，用 tools/fetch-assets.py 重新装配）
# 来源与版本见 assets/SOURCE.md；装配步骤见 README「素材装配」
/assets/models/
/assets/ort/
/assets/tokenizers/
/assets/cuda/
/assets/dicts/
# fetch-assets.py 的中间产物：HF 缓存与 ckpt 落地
/assets/_hfcache/
/assets/_ckpt/

# 提交说明临时文件（曾经被 git add -A 误收两次）
/_msg*.txt
/tmp_*.py
link-tmp/
__pycache__/

# 测试语料：第三方语料 原文，著作权属作者，不随本仓公开。
# 放在外部语料目录，测试前拷入或用 本地语料目录 指过去。
/crates/pipeline/tests/corpus/

# 测试基线：约 36 MB，可由 tools/gen-fixtures.sh 从语料重建。
# 不跟语料一起公开（它们逐行含原文）。
/crates/pipeline/tests/fixtures/*.txt

# 临时基准/探针目录：含 procmon 日志(3.5 GB)、备份的 onnx(460 MB) 等，
# 一律不进 git。 曾因 git add -A 误提交过 4.4 GB，见该日提交说明。
/_bench/
